rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /userChats/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid != userId
        && isNewChatEntryOnly(userId, resource.data, request.resource.data);
    }

    match /chats/{chatId} {
      allow read, update: if request.auth != null
        && exists(/databases/$(database)/documents/userChats/$(request.auth.uid))
        && chatId in get(/databases/$(database)/documents/userChats/$(request.auth.uid)).data.keys();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["messages", "createdAt"])
        && request.resource.data.messages.size() == 0;
    }

    function isNewChatEntryOnly(userId, before, after) {
      let expectedChatId = request.auth.uid > userId
        ? request.auth.uid + userId
        : userId + request.auth.uid;
      let changedKeys = after.diff(before).affectedKeys();
      return changedKeys.hasOnly([expectedChatId])
        && !(expectedChatId in before);
    }
  }
}
